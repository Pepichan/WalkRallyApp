@page
@model WalkRallyApp.Pages.ResultModel
@{
    ViewData["Title"] = "結果発表";
}

<div class="app-page">
    <div class="app-card">
        <div class="app-title">結果発表</div>
        <p class="app-subtitle">お疲れさまでした。</p>

        <div class="app-section">
            <div class="app-section-title">あなたの班</div>
            <div class="app-value">@Model.TeamName</div>
        </div>

        <div class="app-section">
            <div class="app-section-title">合計得点</div>
            <div class="app-value">@Model.Score 点</div>
        </div>

        <div class="app-section">
            <div class="app-section-title">順位</div>
            <div class="app-value">@Model.Rank 位 / @Model.TotalTeams 班</div>
        </div>

        <div class="app-divider"></div>

        <div class="d-grid gap-2 mt-3">
            <a class="btn btn-outline-secondary w-100" asp-page="Join">戻る</a>
        </div>
    </div>
</div>
