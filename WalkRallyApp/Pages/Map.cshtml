@page
@model WalkRallyApp.Pages.MapModel
@{
    ViewData["Title"] = "チェックポイント";
    var runId = Request.Query["runId"];
    var currentId = Model.CurrentCheckPoint?.Id;
    var reached = Model.ReachedCheckpointIds;
}

<div class="app-page">
    <div class="app-card">
        <div class="app-header">
            <div class="app-header-item">
                <div class="app-label">残り時間</div>
                <div class="app-value app-value-large">@Model.RemainingTimeText</div>
            </div>
            <div class="app-header-item text-end">
                <div class="app-label">班</div>
                <div class="app-value app-value-large">@Model.TeamName</div>
            </div>
        </div>

        @if (Model.Alerts.Any())
        {
            <div class="app-section app-alerts">
                @foreach (var alert in Model.Alerts)
                {
                    <div class="alert @alert.CssClass">@alert.Message</div>
                }
            </div>
        }

        @if (Model.Announcements.Any())
        {
            <div class="app-section">
                <div class="app-section-title">お知らせ</div>
                <ul class="list-group list-group-flush">
                    @foreach (var a in Model.Announcements)
                    {
                        <li class="list-group-item">
                            <div>@a.Message</div>
                            <div class="small text-muted">@a.CreatedAt.ToLocalTime():HH:mm</div>
                        </li>
                    }
                </ul>
            </div>
        }

        <div class="app-section">
            <div class="app-section-title">現在のチェックポイント</div>
            @if (Model.CurrentCheckPoint != null)
            {
                var reachedCurrent = reached.Contains(Model.CurrentCheckPoint.Id);
                <div class="app-info-bar">
                    <div>
                        <div class="app-label">番号</div>
                        <div class="app-value">#@Model.CurrentCheckPoint.Order</div>
                    </div>
                    <div>
                        <div class="app-label">種類</div>
                        <div class="app-value">@Model.CurrentCheckPoint.Type</div>
                    </div>
                    <div class="text-end">
                        <div class="app-label">得点</div>
                        <div class="app-value">@Model.CurrentCheckPoint.Points 点</div>
                    </div>
                </div>
                <div class="app-status-pill @(reachedCurrent ? "app-status-pill--done" : "app-status-pill--pending")">
                    @(reachedCurrent ? "到達済み" : "未到達")
                </div>
            }
        </div>

        <div class="app-grid">
            <div class="app-panel">
                <div class="app-panel-title">クイズ</div>
                <div class="app-panel-note">正解すると得点が加算されます。</div>
                @if (Model.CurrentQuestion != null)
                {
                    <form method="post" asp-page-handler="Answer">
                        <input type="hidden" name="runId" value="@runId" />
                        <input type="hidden" name="checkpointId" value="@currentId" />
                        <p class="mb-3">@Model.CurrentQuestion.TextJa</p>

                        @foreach (var choice in Model.CurrentChoices)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="SelectedChoiceId" value="@choice.Id" id="choice_@choice.Id" />
                                <label class="form-check-label" for="choice_@choice.Id">@choice.TextJa</label>
                            </div>
                        }

                        <button class="btn btn-primary mt-3 w-100" type="submit">回答送信</button>
                    </form>
                }
                else
                {
                    <div class="text-muted">このチェックポイントにはクイズがありません。</div>
                }
            </div>

            <div class="app-panel">
                <div class="app-panel-title">到達判定</div>
                <div class="app-panel-note">GPSが使えない場合はQRで判定してください。</div>

                <form method="post" asp-page-handler="ReachGps" class="mb-2">
                    <input type="hidden" name="runId" value="@runId" />
                    <input type="hidden" name="checkpointId" value="@currentId" />
                    <input type="hidden" class="gps-lat" name="Lat" />
                    <input type="hidden" class="gps-lng" name="Lng" />
                    <button class="btn btn-outline-primary w-100" type="button" data-gps-submit="true">GPSで判定</button>
                </form>

                <form method="post" asp-page-handler="ReachQr">
                    <input type="hidden" name="runId" value="@runId" />
                    <input type="hidden" name="checkpointId" value="@currentId" />
                    <input class="form-control mb-2" name="QrInput" placeholder="QRコードの文字列を入力" />
                    <button class="btn btn-outline-secondary w-100" type="submit">QRで判定</button>
                </form>
            </div>

            @if (Model.CurrentCheckPoint?.Type == CheckpointType.Photo)
            {
                <div class="app-panel">
                    <div class="app-panel-title">写真ミッション</div>
                    <div class="app-panel-note">写真を撮影して提出すると得点が加算されます。</div>
                    <form method="post" asp-page-handler="Photo" enctype="multipart/form-data">
                        <input type="hidden" name="runId" value="@runId" />
                        <input type="hidden" name="checkpointId" value="@currentId" />
                        <input type="file" name="PhotoFile" accept="image/*" class="form-control mb-2" />
                        <button class="btn btn-outline-secondary w-100" type="submit">写真を送信</button>
                    </form>
                </div>
            }

            <div class="app-panel">
                <div class="app-panel-title">ゴール判定</div>
                <div class="app-panel-note">ゴール地点で判定してください。</div>

                <form method="post" asp-page-handler="ReachGoalGps" class="mb-2">
                    <input type="hidden" name="runId" value="@runId" />
                    <input type="hidden" class="gps-lat" name="Lat" />
                    <input type="hidden" class="gps-lng" name="Lng" />
                    <button class="btn btn-outline-success w-100" type="button" data-gps-submit="true">ゴール判定（GPS）</button>
                </form>

                <form method="post" asp-page-handler="ReachGoalQr">
                    <input type="hidden" name="runId" value="@runId" />
                    <input class="form-control mb-2" name="GoalQrInput" placeholder="ゴールQRの文字列を入力" />
                    <button class="btn btn-outline-success w-100" type="submit">ゴール判定（QR）</button>
                </form>
            </div>
        </div>

        <div class="app-section">
            <div class="app-section-title">チェックポイント一覧</div>
            <ul class="list-group list-group-flush">
                @foreach (var cp in Model.Checkpoints)
                {
                    var isCurrent = cp.Id == currentId;
                    var isReached = reached.Contains(cp.Id);
                    <li class="list-group-item d-flex justify-content-between align-items-center app-checkpoint-item @(isCurrent ? "app-checkpoint-item--current" : string.Empty)">
                        <div class="app-checkpoint-main">
                            <a class="text-decoration-none" asp-page="Map" asp-route-runId="@runId" asp-route-checkpointId="@cp.Id">
                                #@cp.Order - @cp.Type
                            </a>
                            <span class="app-badge @(isReached ? "app-badge--done" : "app-badge--pending")">
                                @(isReached ? "到達済み" : "未到達")
                            </span>
                        </div>
                        <span class="badge bg-secondary">@cp.Points 点</span>
                    </li>
                }
            </ul>
        </div>
    </div>

    @section Scripts
    {
        <script>
            document.querySelectorAll("[data-gps-submit]").forEach((btn) =>
            {
                btn.addEventListener("click", () =>
                {
                    if (!navigator.geolocation)
                    {
                        alert("このブラウザでは位置情報が使えません。");
                        return;
                    }

                    const form = btn.closest("form");
                    if (!form)
                    {
                        return;
                    }

                    navigator.geolocation.getCurrentPosition((pos) =>
                    {
                        form.querySelector(".gps-lat").value = pos.coords.latitude;
                        form.querySelector(".gps-lng").value = pos.coords.longitude;
                        form.submit();
                    }, () =>
                    {
                        alert("位置情報の取得に失敗しました。");
                    });
                });
            });
        </script>
    }
</div>