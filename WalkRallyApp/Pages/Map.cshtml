@page
@model WalkRallyApp.Pages.MapModel
@{
    ViewData["Title"] = "チェックポイント";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>残り時間：@Model.RemainingTimeText</div>
        <div>班：@Model.TeamName</div>
    </div>

    @if (!string.IsNullOrEmpty(Model.AnswerResult))
    {
        <div class="alert alert-info">@Model.AnswerResult</div>
    }
    
    <div>
        <strong>チェックポイント一覧</strong>
        <ul>
            @foreach (var cp in Model.Checkpoints)
            {
                <li>
                    #@cp.Order - @cp.Type (配点： @cp.Points)
                </li>
            }
        </ul>
    </div>

    @if (Model.CurrentQuestion != null)
    {
      <h2 class="mb-3">チェックポイント #@Model.CurrentCheckPoint?.Order</h2>
      
      <form method="post" asp-page-handler="Answer">
          <input type="hidden" name="runId" value="@Request.Query["runId"]" />
          <div class="mb-3">
              <strong>クイズ</strong>
              <p>@Model.CurrentQuestion.TextJa</p>

              @foreach (var choice in Model.CurrentChoices)
                {
                    <div>
                        <input type="radio" name="SelectedChoiceId" value="@choice.Id" /> 
                        @choice.TextJa
                    </div>
                }
              <button class="btn btn-primary mt-2" type="submit">回答送信</button>
          </div>
        </form>
    }
    else
    {
        <p>クイズがありません。</p>
    }

</div>