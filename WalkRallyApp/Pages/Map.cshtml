@page
@model WalkRallyApp.Pages.MapModel
@{
    ViewData["Title"] = "チェックポイント";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>残り時間：@Model.RemainingTimeText</div>
        <div>班：@Model.TeamName</div>
    </div>

    <h2 class="mb-3">チェックポイント #1</h2>

    <div class="mb-3">
        <strong>到達判定</strong> GPS判定中... or [QR読み取り]
    </div>

    <div class="mb-3">
        <strong>クイズ</strong>
        <p>「シドニーがある州は？」</p>
        <div>
            <input type="radio" name="q1" /> ニューサウスウェールズ州
            <input type="radio" name="q1" /> ビクトリア州
            <input type="radio" name="q1" /> クイーンズランド州
        </div>
        <button class="btn btn-primary mt-2" type="button">回答送信</button>
    </div>

    <div class="mb-3">
        <strong>写真ミッション</strong>
        <button class="btn btn-secondary" type="button">写真を撮影する</button>
    </div>

</div>