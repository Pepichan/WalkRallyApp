@page
@model WalkRallyApp.Pages.joinModel
@{
    ViewData["Title"] = "ウォークラリー受付";
}

<div class = "container">
    <h1 class="mb-3">ウォークラリー受付</h1>

    <form method="post">
        <div class="mb-3">
            <label class="form-label">班名</label>
            <input class="form-control" name="TeamName" />
        </div>

        <div class="mb-3">
            <label class="form-label">人数</label>
            <input class="form-control" name="MemberCount" type="number" min="1" max="100" />
        </div>

        <div class="mb-3">
            <label class="form-label">代表者氏名</label>
            <input class="form-control" name="RepresentativeName" />
        </div>

        <div class="mb-3">
            <label class="form-label">学校名</label>
            <input class="form-control" name="School" />
        </div>

        <div class="mb-3">
            <label class="form-label">メールアドレス</label>
            <input class="form-control" name="Email" type="email" />
        </div>

        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="consent" name="Consent" />
            <label class="form-check-label" for="consent">個人情報の取り扱いに同意する</label>
        </div>

        <button class="btn btn-primary" type="submit">開始</button>
    </form>

</div>