@page
@model WalkRallyApp.Pages.joinModel
@{
    ViewData["Title"] = "ウォークラリー受付";
}

<div class = "container">
    <h1 class="mb-3">ウォークラリー受付</h1>

    <div class="text-danger mb-2" asp-validation-summary="All"></div>

    <form method="post">
        <div class="mb-3">
            <label class="form-label">班名</label>
            <input class="form-control" asp-for="TeamName" />
        </div>

        <div class="mb-3">
            <label class="form-label">人数</label>
            <input class="form-control" asp-for="MemberCount" type="number" min="1" max="100" />
        </div>

        <div class="mb-3">
            <label class="form-label">代表者氏名</label>
            <input class="form-control" asp-for="RepresentativeName" />
        </div>

        <div class="mb-3">
            <label class="form-label">学校名</label>
            <input class="form-control" asp-for="School" />
        </div>

        <div class="mb-3">
            <label class="form-label">メールアドレス</label>
            <input class="form-control" asp-for="Email" type="email" />
        </div>

        <div class="form-check mb-3">
            <input class="form-check-input" asp-for="Consent" />
            <label class="form-check-label" for="consent">個人情報の取り扱いに同意する</label>
        </div>

        <button class="btn btn-primary" type="submit">開始</button>
    </form>

</div>